systemctl daemon-reload
systemctl enable flask-app.service
systemctl start flask-app.service
systemctl status flask-app.service

  apt update && apt install -y postgresql postgresql-contrib
systemctl enable postgresql
systemctl start postgresql

# Démarrer les services Flask
ssh root@192.168.10.112 'systemctl start flask-app.service'
ssh root@192.168.10.114 'systemctl start flask-app.service'

# Démarrer HAProxy
ssh root@192.168.10.111 'systemctl start haproxy'

# Démarrer PostgreSQL
ssh root@192.168.10.115 'systemctl start postgresql'

# Arrêter les services Flask
ssh root@192.168.10.112 'systemctl stop flask-app.service'
ssh root@192.168.10.114 'systemctl stop flask-app.service'

# Arrêter HAProxy
ssh root@192.168.10.111 'systemctl stop haproxy'

# Arrêter PostgreSQL
ssh root@192.168.10.115 'systemctl stop postgresql'

# Vérifier tous les services
for ip in 192.168.10.111 192.168.10.112 192.168.10.114 192.168.10.115; do
    echo "=== VM $ip ==="
    ssh root@$ip "systemctl status haproxy 2>/dev/null | head -3 || systemctl status flask-app.service 2>/dev/null | head -3 || systemctl status postgresql 2>/dev/null | head -3"
done
